__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Corpus text and its tokenized form: large, reproducible, and often private.
# Matched wherever the corpus lives, not at one hardcoded path - `--corpus`
# takes any directory, and naming only data/corpus/ meant a corpus somewhere
# else quietly became committable.
**/documents.jsonl
**/tokens.bin
**/corpus/meta.json

# The source text a corpus was fed FROM is a different thing: small, written
# by hand, and the only record of what a version learned once the derived
# files above are gone.
!corpus/learned/**

# Base weights are large and cached by CI rather than committed.
runs/**/checkpoint.pt
runs/**/best.pt
runs/**/history.json

# versions.json is the lineage record — small, and it belongs in git.
!runs/**/versions.json

# Patch binaries do. A growth patch carries whole new experts - ~19MB, growing
# with the model - but it is the only record of what a version learned, and
# together with the committed base it rebuilds any version exactly. The
# alternative was committing a whole merged model per version, which passes
# GitHub's 100MB file limit at v3 and never comes back under it.
!runs/**/patches/

# The merged current model, though, is a local artifact: `mb patch` rewrites it
# on every version and it is reproducible from the base plus the patches above.
# models/motherbrain-base.pt is the committed one, and never changes.
models/motherbrain.pt

# TLS material: private keys must never be committed.
certs/
*.key
*.pem

# The board's own state: who called, what they posted, what they uploaded.
# It belongs to whoever runs the board, not to the repository.
runs/*/bbs/
runs/*/knowledge.json

# Build metadata, rewritten by every `pip install -e .`
*.egg-info/

# The in-flight sense-training checkpoint: 23MB, rewritten every 400 steps
# by a live process, and superseded the moment the version is recorded. A
# commit of it would capture whichever intermediate the clock landed on.
# Recover an interrupted run from it with `mb hear --tower <file>`, then
# the recorded patch is the thing worth keeping.
**/tower-progress.pt
**/tower-progress.part
