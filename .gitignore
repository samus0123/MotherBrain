__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Corpus text and its tokenized form: large, reproducible, and often private.
data/corpus/documents.jsonl
data/corpus/tokens.bin
data/corpus/meta.json

# Base weights are large and cached by CI rather than committed.
runs/**/checkpoint.pt
runs/**/best.pt
runs/**/history.json

# versions.json is the lineage record — small, and it belongs in git.
!runs/**/versions.json

# Patch binaries do not. A growth patch carries whole new experts, so it is
# ~19MB and grows with the model; committing one per version is unbounded.
# They are reproducible from the corpus and the base checkpoint, and the
# distributable artifact is the exported current model in models/.
runs/**/patches/

# TLS material: private keys must never be committed.
certs/
*.key
*.pem
