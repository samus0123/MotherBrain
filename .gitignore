__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Corpus text and its tokenized form: large, reproducible, and often private.
data/corpus/documents.jsonl
data/corpus/tokens.bin
data/corpus/meta.json

# Base weights are large and cached by CI rather than committed.
runs/**/checkpoint.pt
runs/**/best.pt
runs/**/history.json

# versions.json is the lineage record — small, and it belongs in git.
!runs/**/versions.json

# Patch binaries do. A growth patch carries whole new experts - ~19MB, growing
# with the model - but it is the only record of what a version learned, and
# together with the committed base it rebuilds any version exactly. The
# alternative was committing a whole merged model per version, which passes
# GitHub's 100MB file limit at v3 and never comes back under it.
!runs/**/patches/

# The merged current model, though, is a local artifact: `mb patch` rewrites it
# on every version and it is reproducible from the base plus the patches above.
# models/motherbrain-base.pt is the committed one, and never changes.
models/motherbrain.pt

# TLS material: private keys must never be committed.
certs/
*.key
*.pem
