{
  "name": "motherbrain",
  "model": {
    "vocab_size": 32000,
    "dim": 768,
    "n_layers": 12,
    "n_heads": 12,
    "n_kv_heads": 4,
    "head_dim": 64,
    "max_seq_len": 2048,
    "ffn_hidden": 2048,
    "ffn_mult": 2.6666666666666665,
    "ffn_multiple_of": 128,
    "norm_eps": 1e-05,
    "rope_theta": 10000.0,
    "rope_scaling": 1.0,
    "dropout": 0.0,
    "attn_dropout": 0.0,
    "tie_embeddings": true,
    "logit_softcap": 0.0,
    "n_experts": 1,
    "n_experts_per_tok": 2,
    "n_shared_experts": 0,
    "moe_layer_freq": 1,
    "moe_first_dense_layers": 0,
    "moe_ffn_hidden": 2048,
    "aux_loss_coef": 0.01,
    "router_z_loss_coef": 0.001,
    "router_jitter": 0.0,
    "init_std": 0.02,
    "scale_residual_init": true
  },
  "train": {
    "data_dir": "data/tokens",
    "train_split": "train",
    "val_split": "val",
    "batch_size": 8,
    "seq_len": 1024,
    "grad_accum_steps": 1,
    "max_steps": 2000,
    "warmup_steps": 100,
    "lr": 0.0003,
    "min_lr_ratio": 0.1,
    "schedule": "cosine",
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "eps": 1e-08,
    "grad_clip": 1.0,
    "dtype": "bf16",
    "compile": false,
    "grad_checkpoint": false,
    "device": "auto",
    "out_dir": "runs/motherbrain",
    "log_every": 10,
    "eval_every": 250,
    "eval_steps": 20,
    "save_every": 500,
    "keep_last": 3,
    "seed": 1337,
    "resume": ""
  }
}
